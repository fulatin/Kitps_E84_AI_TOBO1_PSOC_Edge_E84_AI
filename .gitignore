install file/
ESP32.bin
stm32.bin

# === SDK 库文件 ===
mtb-pdl-cat1/
mtb_shared/
mtb-hal-cat1/
mtb-pdl-cat2/
mtb-hal-cat2/
mtbx/
# 注意：不要忽略 *.mtb / *.mtbx！它们是 ModusToolbox 的依赖声明清单
# （proj_*/deps/*.mtb），必须随仓库提交，否则 make getlibs 无依赖可拉取。

